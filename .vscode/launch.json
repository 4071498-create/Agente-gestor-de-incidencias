{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: Terminal integrado",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app",
                "app:create_app",
                "run",
                "--debug",
                "--no-reload"
            ],
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "INCIDENCIAS_USUARIO_PASSWORD": "${input:incidenciasUsuarioPassword}",
                "INCIDENCIAS_TECNICO_PASSWORD": "${input:incidenciasTecnicoPassword}",
                "LMSTUDIO_URL": "http://localhost:1234/v1",
                "LMSTUDIO_MODEL": "${input:lmstudioModel}"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Flask: Consola de depuración",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app",
                "app:create_app",
                "run",
                "--debug",
                "--no-reload"
            ],
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "INCIDENCIAS_USUARIO_PASSWORD": "${input:incidenciasUsuarioPassword}",
                "INCIDENCIAS_TECNICO_PASSWORD": "${input:incidenciasTecnicoPassword}",
                "LMSTUDIO_URL": "http://localhost:1234/v1",
                "LMSTUDIO_MODEL": "${input:lmstudioModel}"
            },
            "console": "internalConsole",
            "redirectOutput": true,
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "incidenciasUsuarioPassword",
            "type": "promptString",
            "description": "Contraseña inicial de la cuenta usuario",
            "password": true
        },
        {
            "id": "incidenciasTecnicoPassword",
            "type": "promptString",
            "description": "Contraseña inicial de la cuenta tecnico",
            "password": true
        },
        {
            "id": "lmstudioModel",
            "type": "promptString",
            "description": "Identificador del modelo cargado en LM Studio",
            "default": "local-model"
        }
    ]
}
